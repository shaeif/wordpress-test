{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"custom": false,
			"customGradient": false,
			"palette": [
				{ "slug": "midnight", "name": "Midnight", "color": "#0A0E14" },
				{ "slug": "surface", "name": "Surface", "color": "#121A24" },
				{ "slug": "line", "name": "Line", "color": "#1F2B38" },
				{ "slug": "steel", "name": "Steel", "color": "#2B3A4A" },
				{ "slug": "lime", "name": "Electric lime", "color": "#C6F432" },
				{ "slug": "lime-ink", "name": "Lime ink (text on light)", "color": "#3E5A12" },
				{ "slug": "cloud", "name": "Cloud", "color": "#F4F6F8" },
				{ "slug": "white", "name": "White", "color": "#FFFFFF" },
				{ "slug": "fog", "name": "Fog (text on dark)", "color": "#E6EBF0" },
				{ "slug": "muted", "name": "Muted (text on dark)", "color": "#A9B6C3" },
				{ "slug": "slate", "name": "Slate (text on light)", "color": "#3A4654" },
				{ "slug": "amber", "name": "Amber", "color": "#E0A43A" },
				{ "slug": "green", "name": "Status green", "color": "#1F6F43" },
				{ "slug": "red", "name": "Status red", "color": "#C43C3C" }
			]
		},
		"layout": {
			"contentSize": "760px",
			"wideSize": "1200px"
		},
		"spacing": {
			"units": [ "px", "rem", "%", "vw" ],
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "1.5rem" },
				{ "slug": "50", "name": "L", "size": "clamp(2rem, 4vw, 3rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(3rem, 7vw, 5rem)" },
				{ "slug": "70", "name": "XXL", "size": "clamp(4rem, 10vw, 7.5rem)" }
			]
		},
		"typography": {
			"fluid": false,
			"customFontSize": true,
			"defaultFontSizes": false,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem" },
				{ "slug": "base", "name": "Base", "size": "1.0625rem" },
				{ "slug": "medium", "name": "Medium", "size": "1.25rem" },
				{ "slug": "large", "name": "Large", "size": "clamp(1.375rem, 2.2vw, 1.625rem)" },
				{ "slug": "x-large", "name": "X-Large", "size": "clamp(2rem, 4vw, 2.75rem)" },
				{ "slug": "xx-large", "name": "Display", "size": "clamp(2.5rem, 6vw, 4.5rem)" }
			],
			"fontFamilies": [
				{
					"slug": "manrope",
					"name": "Manrope",
					"fontFamily": "Manrope, ui-sans-serif, system-ui, -apple-system, 'Segoe UI', sans-serif",
					"fontFace": [
						{
							"fontFamily": "Manrope",
							"fontStyle": "normal",
							"fontWeight": "200 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/manrope-latin-variable.woff2" ]
						}
					]
				},
				{
					"slug": "mono",
					"name": "JetBrains Mono",
					"fontFamily": "'JetBrains Mono', ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
					"fontFace": [
						{
							"fontFamily": "JetBrains Mono",
							"fontStyle": "normal",
							"fontWeight": "100 800",
							"fontDisplay": "swap",
							"src": [ "file:./assets/fonts/jetbrains-mono-latin-variable.woff2" ]
						}
					]
				}
			]
		},
		"shadow": {
			"defaultPresets": false
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--midnight)",
			"text": "var(--wp--preset--color--fog)"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "clamp(1.25rem, 5vw, 4rem)",
				"right": "clamp(1.25rem, 5vw, 4rem)"
			}
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--manrope)",
			"fontSize": "var(--wp--preset--font-size--base)",
			"lineHeight": "1.65",
			"fontWeight": "400"
		},
		"elements": {
			"heading": {
				"typography": {
					"fontWeight": "800",
					"lineHeight": "1.1",
					"letterSpacing": "-0.025em"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)", "letterSpacing": "-0.035em", "lineHeight": "1.04" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)", "letterSpacing": "-0.03em" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)", "letterSpacing": "-0.015em", "lineHeight": "1.25" } },
			"h4": { "typography": { "fontSize": "var(--wp--preset--font-size--medium)", "letterSpacing": "-0.01em", "lineHeight": "1.3" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--lime)" },
				"typography": { "textDecoration": "underline" },
				":hover": { "color": { "text": "var(--wp--preset--color--white)" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--lime)",
					"text": "var(--wp--preset--color--midnight)"
				},
				"border": { "radius": "999px", "width": "0" },
				"spacing": { "padding": { "top": "0.95rem", "bottom": "0.95rem", "left": "1.6rem", "right": "1.6rem" } },
				"typography": { "fontWeight": "700", "fontSize": "1rem", "lineHeight": "1.2", "textDecoration": "none" },
				":hover": {
					"color": { "background": "#D8FF5C", "text": "var(--wp--preset--color--midnight)" }
				},
				":focus": {
					"outline": { "color": "var(--wp--preset--color--white)", "offset": "3px", "style": "solid", "width": "2px" }
				}
			}
		},
		"blocks": {
			"core/navigation": {
				"typography": { "fontSize": "0.9375rem", "fontWeight": "600" }
			},
			"core/quote": {
				"border": { "width": "0" },
				"spacing": { "padding": { "left": "0", "right": "0" } }
			}
		}
	},
	"customTemplates": [
		{
			"name": "page-designed",
			"title": "Designed page (no title)",
			"postTypes": [ "page" ]
		}
	],
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
